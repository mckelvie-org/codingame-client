{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest: Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q",
        "${file}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest: Full Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q",
        "tests"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "CG C++: Debug solution",
      "type": "cppdbg",
      "request": "launch",
      "program": "/build/debug/solution",
      "cwd": "/build",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "miDebuggerServerAddress": "localhost:2345",
      "stopAtEntry": true,
      "externalConsole": false,
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": [
          "exec",
          "-i",
          "cg-cpp-9e84e543be86",
          "sh",
          "-c"
        ],
        "debuggerPath": "/usr/bin/gdb",
        "pipeCwd": ""
      },
      "preLaunchTask": "CG C++: Start debug session",
      "postDebugTask": "CG C++: Stop debug session"
    },
    {
      "name": "CG Python3: Debug solution",
      "type": "debugpy",
      "request": "launch",
      "module": "codingame_tools.debug",
      "args": [
        "${file}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
