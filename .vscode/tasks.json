{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pdm: install",
      "type": "shell",
      "command": "pdm",
      "args": [
        "install"
      ],
      "group": "build"
    },
    {
      "label": "pdm: lint",
      "type": "shell",
      "command": "pdm",
      "args": [
        "run",
        "lint"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "pdm: typecheck",
      "type": "shell",
      "command": "pdm",
      "args": [
        "run",
        "typecheck"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "pdm: test",
      "type": "shell",
      "command": "pdm",
      "args": [
        "run",
        "test"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "pdm: build",
      "type": "shell",
      "command": "pdm",
      "args": [
        "build"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "pdm: check all",
      "type": "shell",
      "command": "pdm",
      "args": [
        "run",
        "lint"
      ],
      "dependsOrder": "sequence",
      "dependsOn": [
        "pdm: lint",
        "pdm: typecheck",
        "pdm: test"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "CG C++: Prepare debug session",
      "type": "shell",
      "command": "cg debug start --file \"${file}\" --workspace-root \"${workspaceFolder}\"",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": true,
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "cg-cpp",
        "fileLocation": "absolute",
        "pattern": [
          {
            "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ]
      }
    }
  ]
}
